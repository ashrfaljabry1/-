        // عناصر DOM
        const navButtons = document.querySelectorAll('.nav-btn');
        const azkarContainer = document.getElementById('azkarContainer');
        const sectionTitle = document.getElementById('sectionTitle');
        const progressFill = document.getElementById('progressFill');
        const progressText = document.getElementById('progressText');
        const searchInput = document.getElementById('searchInput');
        const themeToggle = document.getElementById('themeToggle');
        const fontIncrease = document.getElementById('fontIncrease');
        const fontDecrease = document.getElementById('fontDecrease');
        const resetAll = document.getElementById('resetAll');
        const scrollToTop = document.getElementById('scrollToTop');

        // إعدادات التطبيق
        let currentCategory = 'morning';
        let userProgress = {};
        let userFavorites = [];
        let fontSize = 1; // عامل تكبير الخط

        // تهيئة التطبيق
        function initApp() {
            // تحميل التقدم المحفوظ
            loadProgress();
            
            // تحميل المفضلات
            loadFavorites();
            
            // عرض أذكار الصباح أولاً
            displayAzkar(currentCategory);
            
            // إضافة أحداث لأزرار التنقل
            navButtons.forEach(button => {
                button.addEventListener('click', () => {
                    // إزالة الفعال من جميع الأزرار
                    navButtons.forEach(btn => btn.classList.remove('active'));
                    // إضافة الفعال للزر المضغوط
                    button.classList.add('active');
                    // تغيير الفئة الحالية
                    currentCategory = button.dataset.category;
                    // تحديث العنوان
                    updateSectionTitle();
                    // عرض الأذكار الجديدة
                    displayAzkar(currentCategory);
                });
            });
            
            // إضافة حدث البحث
            searchInput.addEventListener('input', handleSearch);
            
            // إضافة أحداث التحكم
            themeToggle.addEventListener('click', toggleTheme);
            fontIncrease.addEventListener('click', increaseFont);
            fontDecrease.addEventListener('click', decreaseFont);
            resetAll.addEventListener('click', resetAllProgress);
            
            // إضافة حدث للتمرير
            window.addEventListener('scroll', handleScroll);
            scrollToTop.addEventListener('click', scrollToTopHandler);
            
            // تحديث شريط التقدم
            updateProgressBar();
            
            // تهيئة وضع الليل إذا كان مفعلًا
            if (localStorage.getItem('darkMode') === 'true') {
                document.body.classList.add('dark-mode');
                themeToggle.innerHTML = '<i class="fas fa-sun"></i> وضع النهار';
            }
            
            // تهيئة حجم الخط
            const savedFontSize = localStorage.getItem('fontSize');
            if (savedFontSize) {
                fontSize = parseFloat(savedFontSize);
                updateFontSize();
            }
        }

        // تحديث عنوان القسم
        function updateSectionTitle() {
            const titles = {
                morning: 'أذكار الصباح',
                evening: 'أذكار المساء',
                sleep: 'أذكار النوم',
                wakeup: 'أذكار الاستيقاظ',
                prayer: 'أذكار بعد الصلاة',
                mosque: 'أذكار المسجد',
                food: 'أذكار الطعام',
                travel: 'أذكار السفر',
                protection: 'أذكار الحماية',
                general: 'أذكار متنوعة',
                favorites: 'الأذكار المفضلة'
            };
            
            sectionTitle.textContent = titles[currentCategory];
        }

        // عرض الأذكار
        function displayAzkar(category, searchTerm = '') {
            // مسح المحتوى الحالي
            azkarContainer.innerHTML = '';
            
            // الحصول على الأذكار للفئة المحددة
            let azkar = [];
            
            if (category === 'favorites') {
                // عرض الأذكار المفضلة فقط
                azkar = getAllAzkar().filter(azkr => userFavorites.includes(azkr.id));
            } else {
                azkar = azkarData[category] || [];
            }
            
            // فلترة النتائج إذا كان هناك بحث
            if (searchTerm) {
                azkar = azkar.filter(azkr => 
                    azkr.text.includes(searchTerm) || 
                    azkr.description.includes(searchTerm) ||
                    azkr.reference.includes(searchTerm)
                );
            }
            
            // إذا لم توجد نتائج
            if (azkar.length === 0) {
                azkarContainer.innerHTML = `
                    <div style="grid-column: 1 / -1; text-align: center; padding: 2rem;">
                        <i class="fas fa-search" style="font-size: 3rem; color: #ccc; margin-bottom: 1rem;"></i>
                        <p>لا توجد أذكار تطابق بحثك</p>
                    </div>
                `;
                return;
            }
            
            // إنشاء بطاقات للأذكار
            azkar.forEach((zekr, index) => {
                const zekrId = category === 'favorites' ? zekr.id : `${category}-${index}`;
                const currentCount = userProgress[zekrId] !== undefined ? userProgress[zekrId] : zekr.count;
                const isFavorite = userFavorites.includes(zekrId);
                
                const zekrCard = document.createElement('div');
                zekrCard.className = 'zekr-card';
                zekrCard.style.animationDelay = `${index * 0.1}s`;
                
                zekrCard.innerHTML = `
                    <div class="zekr-content">
                        <p class="zekr-text">${zekr.text}</p>
                        ${zekr.description ? `<p class="zekr-description">${zekr.description}</p>` : ''}
                        <p class="zekr-reference">${zekr.reference}</p>
                    </div>
                    <div class="zekr-actions">
                        <button class="action-btn favorite ${isFavorite ? 'active' : ''}" data-id="${zekrId}">
                            <i class="fas fa-heart"></i>
                        </button>
                        <button class="action-btn" onclick="speakText('${zekr.text.replace(/'/g, "\\'")}')">
                            <i class="fas fa-volume-up"></i>
                        </button>
                        <button class="action-btn" onclick="copyToClipboard('${zekr.text.replace(/'/g, "\\'")}')">
                            <i class="fas fa-copy"></i>
                        </button>
                    </div>
                    <div class="counter-container">
                        <button class="counter-btn" data-id="${zekrId}" data-total="${zekr.count}" ${currentCount === 0 ? 'disabled' : ''}>
                            <i class="fas fa-minus"></i>
                        </button>
                        <div class="counter-display" id="counter-${zekrId}">${currentCount}</div>
                        <button class="counter-btn reset-btn" data-id="${zekrId}" data-total="${zekr.count}">
                            <i class="fas fa-redo"></i>
                        </button>
                    </div>
                    <p class="completed" id="completed-${zekrId}">✓ تم إكمال الذكر</p>
                `;
                
                azkarContainer.appendChild(zekrCard);
                
                // التحقق مما إذا كان الذكر مكتملاً
                if (currentCount === 0) {
                    document.getElementById(`completed-${zekrId}`).style.display = 'block';
                }
                
                // إضافة أحداث للأزرار
                const counterBtn = zekrCard.querySelector('.counter-btn:not(.reset-btn)');
                const resetBtn = zekrCard.querySelector('.reset-btn');
                const favoriteBtn = zekrCard.querySelector('.favorite');
                
                counterBtn.addEventListener('click', () => {
                    decreaseCounter(zekrId, zekr.count);
                });
                
                resetBtn.addEventListener('click', () => {
                    resetCounter(zekrId, zekr.count);
                });
                
                favoriteBtn.addEventListener('click', () => {
                    toggleFavorite(zekrId, favoriteBtn);
                });
            });
        }

        // تقليل العداد
        function decreaseCounter(zekrId, totalCount) {
            const currentCount = userProgress[zekrId] !== undefined ? userProgress[zekrId] : totalCount;
            
            if (currentCount > 0) {
                userProgress[zekrId] = currentCount - 1;
                updateCounterDisplay(zekrId);
                saveProgress();
                updateProgressBar();
                
                // تحديث حالة الزر
                if (userProgress[zekrId] === 0) {
                    document.querySelector(`.counter-btn[data-id="${zekrId}"]`).disabled = true;
                    document.getElementById(`completed-${zekrId}`).style.display = 'block';
                    document.getElementById(`counter-${zekrId}`).classList.add('bounce');
                    
                    // تشغيل صوت النقر إذا كان مفعلًا
                    if (document.getElementById('soundSetting').checked) {
                        playClickSound();
                    }
                    
                    // إزالة تأثير الارتداد بعد انتهاء التحميل
                    setTimeout(() => {
                        document.getElementById(`counter-${zekrId}`).classList.remove('bounce');
                    }, 500);
                }
            }
        }

        // إعادة تعيين العداد
        function resetCounter(zekrId, totalCount) {
            userProgress[zekrId] = totalCount;
            updateCounterDisplay(zekrId);
            saveProgress();
            updateProgressBar();
            document.getElementById(`completed-${zekrId}`).style.display = 'none';
            document.querySelector(`.counter-btn[data-id="${zekrId}"]`).disabled = false;
        }

        // تحديث عرض العداد
        function updateCounterDisplay(zekrId) {
            const counterElement = document.getElementById(`counter-${zekrId}`);
            if (counterElement) {
                counterElement.textContent = userProgress[zekrId];
            }
        }

        // تبديل المفضلة
        function toggleFavorite(zekrId, button) {
            if (userFavorites.includes(zekrId)) {
                userFavorites = userFavorites.filter(id => id !== zekrId);
                button.classList.remove('active');
            } else {
                userFavorites.push(zekrId);
                button.classList.add('active');
            }
            saveFavorites();
            
            // إذا كنا في قسم المفضلة، قم بتحديث العرض
            if (currentCategory === 'favorites') {
                displayAzkar(currentCategory);
            }
        }

        // البحث في الأذكار
        function handleSearch() {
            const searchTerm = searchInput.value.trim();
            displayAzkar(currentCategory, searchTerm);
        }

        // تبديل وضع الليل/النهار
        function toggleTheme() {
            document.body.classList.toggle('dark-mode');
            const isDarkMode = document.body.classList.contains('dark-mode');
            
            if (isDarkMode) {
                themeToggle.innerHTML = '<i class="fas fa-sun"></i> وضع النهار';
            } else {
                themeToggle.innerHTML = '<i class="fas fa-moon"></i> وضع الليل';
            }
            
            localStorage.setItem('darkMode', isDarkMode);
        }

        // تكبير الخط
        function increaseFont() {
            if (fontSize < 1.5) {
                fontSize += 0.1;
                updateFontSize();
                saveFontSize();
            }
        }

        // تصغير الخط
        function decreaseFont() {
            if (fontSize > 0.8) {
                fontSize -= 0.1;
                updateFontSize();
                saveFontSize();
            }
        }

        // تحديث حجم الخط
        function updateFontSize() {
            document.documentElement.style.fontSize = `calc(${fontSize} * 16px)`;
        }

        // حفظ حجم الخط
        function saveFontSize() {
            localStorage.setItem('fontSize', fontSize.toString());
        }

        // إعادة تعيين كل التقدم
        function resetAllProgress() {
            if (confirm('هل أنت متأكد من إعادة تعيين كل التقدم؟')) {
                userProgress = {};
                saveProgress();
                displayAzkar(currentCategory);
                updateProgressBar();
            }
        }

        // التعامل مع التمرير
        function handleScroll() {
            if (window.pageYOffset > 300) {
                scrollToTop.classList.add('visible');
            } else {
                scrollToTop.classList.remove('visible');
            }
        }

        // الانتقال للأعلى
        function scrollToTopHandler() {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        }

        // تشغيل صوت النقر
        function playClickSound() {
            const audioContext = new (window.AudioContext || window.webkitAudioContext)();
            const oscillator = audioContext.createOscillator();
            const gainNode = audioContext.createGain();
            
            oscillator.connect(gainNode);
            gainNode.connect(audioContext.destination);
            
            oscillator.frequency.value = 800;
            oscillator.type = 'sine';
            
            gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.1);
            
            oscillator.start(audioContext.currentTime);
            oscillator.stop(audioContext.currentTime + 0.1);
        }

        // Text-to-Speech
        function speakText(text) {
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'ar-SA';
                utterance.rate = 0.8;
                speechSynthesis.speak(utterance);
            } else {
                alert('عذراً، هذه الميزة غير مدعومة في متصفحك');
            }
        }

        // نسخ النص للحافظة
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                // إشعار بنسخ النص
                const notification = document.createElement('div');
                notification.textContent = 'تم نسخ النص إلى الحافظة';
                notification.style.cssText = `
                    position: fixed;
                    bottom: 20px;
                    right: 50%;
                    transform: translateX(50%);
                    background: var(--primary-color);
                    color: white;
                    padding: 10px 20px;
                    border-radius: 5px;
                    z-index: 1000;
                    transition: opacity 0.3s;
                `;
                document.body.appendChild(notification);
                
                setTimeout(() => {
                    notification.style.opacity = '0';
                    setTimeout(() => {
                        document.body.removeChild(notification);
                    }, 300);
                }, 2000);
            }).catch(err => {
                console.error('فشل في نسخ النص: ', err);
            });
        }

        // الحصول على جميع الأذكار
        function getAllAzkar() {
            const allAzkar = [];
            for (const category in azkarData) {
                azkarData[category].forEach((azkr, index) => {
                    allAzkar.push({
                        ...azkr,
                        id: `${category}-${index}`,
                        category: category
                    });
                });
            }
            return allAzkar;
        }

        // تحديث شريط التقدم
        function updateProgressBar() {
            let totalAzkar = 0;
            let completedAzkar = 0;
            
            // حساب إجمالي الأذكار والمكتملة
            for (const category in azkarData) {
                azkarData[category].forEach((zekr, index) => {
                    const zekrId = `${category}-${index}`;
                    totalAzkar += zekr.count;
                    
                    const currentCount = userProgress[zekrId] !== undefined ? userProgress[zekrId] : zekr.count;
                    completedAzkar += (zekr.count - currentCount);
                });
            }
            
            // حساب النسبة المئوية
            const percentage = totalAzkar > 0 ? Math.round((completedAzkar / totalAzkar) * 100) : 0;
            
            // تحديث شريط التقدم
            progressFill.style.width = `${percentage}%`;
            
            // تحديث النص
            if (completedAzkar === 0) {
                progressText.textContent = 'لم تقم بأي ذكر بعد';
            } else if (completedAzkar === totalAzkar) {
                progressText.textContent = 'تهانينا! لقد أكملت جميع الأذكار لهذا اليوم';
            } else {
                progressText.textContent = `أكملت ${completedAzkar} من أصل ${totalAzkar} ذكرًا (${percentage}%)`;
            }
        }

        // حفظ التقدم في localStorage
        function saveProgress() {
            // إضافة تاريخ اليوم للتقدم
            const today = new Date().toDateString();
            const progressData = {
                date: today,
                progress: userProgress
            };
            
            localStorage.setItem('azkarProgress', JSON.stringify(progressData));
        }

        // تحميل التقدم من localStorage
        function loadProgress() {
            const savedProgress = localStorage.getItem('azkarProgress');
            
            if (savedProgress) {
                const progressData = JSON.parse(savedProgress);
                const today = new Date().toDateString();
                
                // إذا كان التقدم محفوظًا ليوم آخر، نبدأ من جديد
                if (progressData.date === today) {
                    userProgress = progressData.progress;
                } else {
                    userProgress = {};
                    saveProgress(); // حفظ تقدم جديد لليوم الحالي
                }
            } else {
                userProgress = {};
            }
        }

        // حفظ المفضلة
        function saveFavorites() {
            localStorage.setItem('azkarFavorites', JSON.stringify(userFavorites));
        }

        // تحميل المفضلة
        function loadFavorites() {
            const savedFavorites = localStorage.getItem('azkarFavorites');
            userFavorites = savedFavorites ? JSON.parse(savedFavorites) : [];
        }

        // تهيئة التطبيق عند تحميل الصفحة
        document.addEventListener('DOMContentLoaded', initApp);
    </script>
</body>
</html>
